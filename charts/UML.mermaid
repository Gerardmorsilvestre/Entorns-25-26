classDiagram
    direction TB

    %% 1. EL PRODUCTE (L'eix central)
    class Entrada {
        +int id
        +float preu
        +String estat
        +assignarPropietari(client)
        +validarEntrada()
        +canviarEstat(nouEstat)
    }

    %% 2. EL CONTEXT (On existeix el producte)
    class Esdeveniment {
        +String nom
        +String descripcio
        +Date data
        +String ubicacio
        +int entradesDisponibles
        +actualitzarStock()
        +obtenirInfo()
        +generarInformeVendes()
    }

    %% 3. ELS ACTORS (Qui interactua amb el sistema)
    class Usuari {
        <<abstract>>
        +String nom
        +String email
        -String contrasenya
        +registrar()
        +iniciarSessio(email, pass)
        +tancarSessio()
    }

    class Client {
        +List historialCompres
        +cercarEsdeveniment(criteri)
        +comprarEntrada(esdeveniment)
        +cancelarReserva(entradaId)
    }

    class Administrador {
        +int nivellPermisos
        +crearEsdeveniment(dades)
        +modificarEsdeveniment(id, dades)
        +eliminarEsdeveniment(id)
    }

    %% Relacions organitzades per dependència
    Esdeveniment "1" *-- "1..*" Entrada : genera
    Client "1" o-- "*" Entrada : compra/posseeix
    Administrador "1" --> "*" Esdeveniment : controla
    Usuari <|-- Client
    Usuari <|-- Administrador